{
  "name": "hush-echolocation-horror",
  "private": true,
  "version": "1.0.0",
  "description": "ТИШЕ / HUSH — low-poly echolocation horror with online co-op. Your microphone is your sonar in a pitch-black forest. Start five generators. Don't scream.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "build:pages": "vite build --outDir play --emptyOutDir",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build && npx --yes electron@45.0.0 .",
    "desktop:dev": "npx --yes electron@45.0.0 .",
    "desktop:win": "npm run build && npx --yes electron-builder@26.15.3 --win portable --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/rubik-wet-paint": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@trystero-p2p/nostr": "0.26.0",
    "@trystero-p2p/torrent": "0.26.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  },
  "author": "HUSH",
  "main": "electron/main.cjs"
}
